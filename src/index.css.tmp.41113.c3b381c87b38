@tailwind base;
@tailwind components;
@tailwind utilities;

/* =================================================================== */
/*  DESIGN TOKENS — dark + premium + cinematic + technical              */
/* =================================================================== */
:root {
  --bg: #050608;
  --bg-2: #08090c;
  --graphite: #0c0e12;
  --surface: #101318;
  --surface-2: #151920;
  --line: rgba(255, 255, 255, 0.07);
  --line-strong: rgba(255, 255, 255, 0.14);

  --red: #ff2d3d;
  --red-hot: #ff5a66;
  --red-deep: #b3101e;
  --red-glow: rgba(255, 45, 61, 0.42);

  --cyan: #63d9ff;
  --cyan-dim: rgba(99, 217, 255, 0.45);

  --text: #eef0f3;
  --text-dim: #a3abb6;
  --muted: #6b7380;

  --radius: 14px;
  --ease: cubic-bezier(0.2, 0.8, 0.2, 1);
  --wrap: min(1240px, calc(100% - 32px));

  --font-display: "Space Grotesk", system-ui, sans-serif;
  --font-body: "Inter", system-ui, sans-serif;
  --font-mono: "JetBrains Mono", ui-monospace, monospace;

  /* shadcn primitives (toasts / tooltips) mapped onto the theme */
  --background: 225 23% 3%;
  --foreground: 216 17% 95%;
  --card: 220 18% 8%;
  --card-foreground: 216 17% 95%;
  --popover: 220 18% 8%;
  --popover-foreground: 216 17% 95%;
  --primary: 355 100% 59%;
  --primary-foreground: 0 0% 100%;
  --secondary: 220 15% 12%;
  --secondary-foreground: 216 17% 95%;
  --muted-hsl: 220 10% 45%;
  --muted-foreground: 216 10% 68%;
  --accent: 220 15% 12%;
  --accent-foreground: 216 17% 95%;
  --destructive: 355 100% 59%;
  --destructive-foreground: 0 0% 100%;
  --border: 220 12% 14%;
  --input: 220 12% 14%;
  --ring: 355 100% 59%;

  color-scheme: dark;
}

* { box-sizing: border-box; }

html {
  scroll-behavior: smooth;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
  text-rendering: optimizeLegibility;
  background: var(--bg);
}

body {
  margin: 0;
  min-width: 320px;
  background: var(--bg);
  color: var(--text);
  font-family: var(--font-body);
  overflow-x: hidden;
}

a { color: inherit; text-decoration: none; }
img, svg, canvas { display: block; }
::selection { background: rgba(255, 45, 61, 0.3); color: #fff; }

:focus-visible {
  outline: 2px solid var(--red);
  outline-offset: 3px;
  border-radius: 6px;
}

::-webkit-scrollbar { width: 10px; height: 10px; }
::-webkit-scrollbar-track { background: var(--bg); }
::-webkit-scrollbar-thumb { background: #1c2129; border-radius: 10px; border: 2px solid var(--bg); }
::-webkit-scrollbar-thumb:hover { background: #2a313c; }

/* =================================================================== */
/*  COMPONENT LAYER                                                     */
/* =================================================================== */
@layer components {
  .wrap { width: var(--wrap); margin-inline: auto; }

  .font-display { font-family: var(--font-display); }
  .font-mono { font-family: var(--font-mono); }

  /* ---- Technical labels ---- */
  .hud {
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--text-dim);
  }
  .eyebrow::before {
    content: "";
    width: 7px; height: 7px;
    background: var(--red);
    box-shadow: 0 0 10px var(--red-glow);
  }

  /* ---- Display type ---- */
  .display {
    font-family: var(--font-display);
    font-weight: 700;
    letter-spacing: -0.035em;
    line-height: 0.92;
    color: var(--text);
  }
  .mega {
    font-family: var(--font-display);
    font-weight: 700;
    letter-spacing: -0.05em;
    line-height: 0.84;
  }
  .text-outline {
    color: transparent;
    -webkit-text-stroke: 1px rgba(255, 255, 255, 0.22);
  }
  .text-metal {
    background: linear-gradient(180deg, #ffffff 0%, #d9dde3 45%, #8c939e 100%);
    -webkit-background-clip: text; background-clip: text; color: transparent;
  }
  .text-signal {
    background: linear-gradient(100deg, var(--red-hot), var(--red) 55%, var(--red-deep));
    -webkit-background-clip: text; background-clip: text; color: transparent;
  }

  /* ---- Surfaces ---- */
  .panel {
    position: relative;
    background:
      linear-gradient(180deg, rgba(255, 255, 255, 0.035), rgba(255, 255, 255, 0.008) 40%),
      var(--graphite);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.05);
  }
  .glass {
    background: rgba(10, 12, 16, 0.72);
    backdrop-filter: blur(14px) saturate(140%);
    -webkit-backdrop-filter: blur(14px) saturate(140%);
    border: 1px solid var(--line);
  }
  /* corner ticks — pure background, no extra DOM */
  .frame::after {
    content: "";
    position: absolute;
    inset: -1px;
    pointer-events: none;
    border-radius: inherit;
    --tk: rgba(255, 255, 255, 0.35);
    --tl: 12px;
    background:
      linear-gradient(var(--tk), var(--tk)) top left / var(--tl) 1px no-repeat,
      linear-gradient(var(--tk), var(--tk)) top left / 1px var(--tl) no-repeat,
      linear-gradient(var(--tk), var(--tk)) top right / var(--tl) 1px no-repeat,
      linear-gradient(var(--tk), var(--tk)) top right / 1px var(--tl) no-repeat,
      linear-gradient(var(--tk), var(--tk)) bottom left / var(--tl) 1px no-repeat,
      linear-gradient(var(--tk), var(--tk)) bottom left / 1px var(--tl) no-repeat,
      linear-gradient(var(--tk), var(--tk)) bottom right / var(--tl) 1px no-repeat,
      linear-gradient(var(--tk), var(--tk)) bottom right / 1px var(--tl) no-repeat;
  }
  .grid-bg {
    background-image:
      linear-gradient(rgba(255, 255, 255, 0.045) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.045) 1px, transparent 1px);
    background-size: 32px 32px;
  }

  /* ---- Buttons ---- */
  .btn {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    overflow: hidden;
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    padding: 15px 22px;
    border-radius: 12px;
    border: 1px solid transparent;
    cursor: pointer;
    isolation: isolate;
    transition: background 0.3s var(--ease), border-color 0.3s var(--ease), box-shadow 0.3s var(--ease), color 0.3s;
  }
  .btn-primary {
    color: #fff;
    background: linear-gradient(135deg, #ff3b4a, var(--red-deep));
    box-shadow: 0 14px 34px -14px var(--red-glow), inset 0 1px 0 rgba(255, 255, 255, 0.25);
  }
  .btn-primary:hover { box-shadow: 0 18px 44px -12px var(--red-glow), inset 0 1px 0 rgba(255, 255, 255, 0.3); }
  .btn-ghost {
    color: var(--text);
    background: rgba(255, 255, 255, 0.025);
    border-color: var(--line-strong);
  }
  .btn-ghost:hover { border-color: rgba(255, 255, 255, 0.32); background: rgba(255, 255, 255, 0.05); }
  /* click ripple — position set via --rx/--ry */
  .btn::after {
    content: "";
    position: absolute;
    left: var(--rx, 50%); top: var(--ry, 50%);
    width: 8px; height: 8px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.35);
    transform: translate(-50%, -50%) scale(0);
    opacity: 0;
    z-index: -1;
    pointer-events: none;
  }
  .btn.rippling::after { animation: ripple 0.6s var(--ease); }

  .chip {
    display: inline-flex;
    align-items: center;
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: 0.04em;
    padding: 5px 9px;
    border-radius: 7px;
    border: 1px solid var(--line);
    color: var(--text-dim);
    background: rgba(255, 255, 255, 0.02);
    white-space: nowrap;
  }

  .link-line {
    background: linear-gradient(currentColor, currentColor) 0 100% / 0 1px no-repeat;
    transition: background-size 0.35s var(--ease), color 0.2s;
  }
  .link-line:hover { background-size: 100% 1px; }

  .dot-live {
    width: 7px; height: 7px; border-radius: 999px;
    background: #2ee6a0;
    box-shadow: 0 0 0 3px rgba(46, 230, 160, 0.14);
  }
}

/* =================================================================== */
/*  GLOBAL ATMOSPHERE (fixed, compositor-only)                          */
/* =================================================================== */
.fx-glow {
  position: fixed; inset: 0; z-index: 0; pointer-events: none;
  background:
    radial-gradient(70rem 46rem at 82% -6%, rgba(255, 45, 61, 0.09), transparent 62%),
    radial-gradient(50rem 40rem at -6% 18%, rgba(99, 217, 255, 0.04), transparent 58%),
    radial-gradient(60rem 30rem at 50% 108%, rgba(255, 45, 61, 0.05), transparent 60%);
}
.fx-noise {
  position: fixed; inset: 0; z-index: 1; pointer-events: none;
  opacity: 0.045;
  background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 160 160' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.85' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E");
}
.fx-scan {
  position: fixed; inset: 0; z-index: 1; pointer-events: none;
  opacity: 0.35;
  background: repeating-linear-gradient(to bottom, transparent 0 2px, rgba(0, 0, 0, 0.22) 3px, transparent 4px);
}

/* =================================================================== */
/*  REVEAL (CSS-only; JS adds .in via a single IntersectionObserver)    */
/* =================================================================== */
.reveal {
  opacity: 0;
  transform: translateY(28px);
  filter: blur(6px);
  transition: opacity 0.9s var(--ease), transform 0.9s var(--ease), filter 0.9s var(--ease);
  transition-delay: var(--d, 0ms);
}
.reveal.in { opacity: 1; transform: none; filter: none; }

/* Mask wipe: the clipped CHILD is translated inside an overflow-hidden parent.
   The IntersectionObserver watches the PARENT ([data-reveal]) — never the
   clipped child — because a fully clip-pathed element reports as not
   intersecting and would never reveal. */
.clip-reveal { transform: translateY(108%); transition: transform 1.1s var(--ease); transition-delay: var(--d, 0ms); will-change: transform; }
[data-reveal].in .clip-reveal { transform: none; }

/* =================================================================== */
/*  CURSOR                                                              */
/* =================================================================== */
.cursor {
  position: fixed; top: 0; left: 0; z-index: 9999;
  pointer-events: none;
  will-change: transform;
}
.cursor-dot {
  width: 6px; height: 6px; margin: -3px 0 0 -3px;
  border-radius: 999px;
  background: var(--red);
  box-shadow: 0 0 12px var(--red-glow);
  transition: opacity 0.2s;
}
.cursor-ring {
  display: grid; place-items: center;
  width: 0; height: 0;
}
.cursor-ring > span {
  display: grid; place-items: center;
  width: 30px; height: 30px;
  border-radius: 999px;
  border: 1px solid rgba(255, 255, 255, 0.0);
  font-family: var(--font-mono);
  font-size: 9px; letter-spacing: 0.16em; color: #fff;
  transform: scale(0.4);
  opacity: 0;
  transition: transform 0.3s var(--ease), opacity 0.3s var(--ease), border-color 0.3s, background 0.3s, width 0.3s var(--ease), height 0.3s var(--ease);
}
.cursor-ring[data-mode="hover"] > span { opacity: 1; transform: scale(1); width: 44px; height: 44px; border-color: rgba(255, 255, 255, 0.55); }
.cursor-ring[data-mode="label"] > span {
  opacity: 1; transform: scale(1); width: 78px; height: 78px;
  border-color: rgba(255, 45, 61, 0.8);
  background: rgba(255, 45, 61, 0.12);
  backdrop-filter: blur(4px);
}
.cursor-ring:not([data-mode="label"]) > span { color: transparent; }
body.has-cursor, body.has-cursor a, body.has-cursor button, body.has-cursor [role="button"] { cursor: none; }
body.has-cursor input, body.has-cursor textarea { cursor: text; }

/* =================================================================== */
/*  PROJECT PANELS                                                      */
/* =================================================================== */
.tilt {
  transform: perspective(1200px) rotateX(var(--rx, 0deg)) rotateY(var(--ry, 0deg));
  transition: transform 0.5s var(--ease);
  transform-style: preserve-3d;
}
.tilt.is-active { transition: transform 0.12s linear; }
.spot {
  background: radial-gradient(420px circle at var(--sx, 50%) var(--sy, 50%), rgba(255, 45, 61, 0.13), transparent 60%);
  opacity: 0; transition: opacity 0.4s;
}
.group:hover .spot { opacity: 1; }
.scanline {
  position: absolute; left: 0; right: 0; top: 0; height: 30%;
  background: linear-gradient(180deg, transparent, rgba(255, 45, 61, 0.1) 70%, rgba(255, 45, 61, 0.55) 99%, transparent);
  transform: translateY(-110%);
  opacity: 0;
  pointer-events: none;
}
.group:hover .scanline { animation: scan 2.2s var(--ease) infinite; opacity: 1; }

/* =================================================================== */
/*  KEYFRAMES / SMALL LOOPS                                             */
/* =================================================================== */
@keyframes ripple { 0% { opacity: 0.6; transform: translate(-50%, -50%) scale(0); } 100% { opacity: 0; transform: translate(-50%, -50%) scale(40); } }
@keyframes scan { to { transform: translateY(380%); } }
@keyframes pulse { 0%, 100% { opacity: 1; } 50% { opacity: 0.35; } }
.pulse { animation: pulse 1.8s ease-in-out infinite; }
@keyframes blink { 0%, 49% { opacity: 1; } 50%, 100% { opacity: 0; } }
.caret { animation: blink 1s step-end infinite; }
@keyframes float-y { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-10px); } }
.float-y { animation: float-y 7s ease-in-out infinite; }
@keyframes dash { to { stroke-dashoffset: -400; } }
.trace { stroke-dasharray: 3 9; animation: dash 14s linear infinite; }
@keyframes spin { to { transform: rotate(360deg); } }
@keyframes log-in { from { opacity: 0; transform: translateY(6px); } to { opacity: 1; transform: none; } }
@keyframes marquee { to { transform: translateX(-50%); } }
.marquee-track { display: inline-flex; white-space: nowrap; animation: marquee 40s linear infinite; }
@keyframes sweep { from { transform: rotate(0deg); } to { transform: rotate(360deg); } }

/* Animations inside paused/offscreen regions stop burning frames */
[data-paused="true"] * { animation-play-state: paused !important; }

/* =================================================================== */
/*  BLOG ARTICLE                                                        */
/* =================================================================== */
.article p { color: var(--text-dim); line-height: 1.8; }
.article a { color: var(--red-hot); text-decoration: underline; text-underline-offset: 3px; word-break: break-all; }

/* =================================================================== */
/*  ACCESSIBILITY                                                       */
/* =================================================================== */
.skip-link {
  position: fixed; left: 16px; top: -60px; z-index: 10000;
  padding: 10px 14px; border-radius: 10px;
  background: var(--red); color: #fff;
  font-family: var(--font-mono); font-size: 12px; letter-spacing: 0.1em;
  transition: top 0.2s;
}
.skip-link:focus { top: 16px; }

@media (prefers-reduced-motion: reduce) {
  html { scroll-behavior: auto; }
  *, *::before, *::after {
    animation-duration: 0.001ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.001ms !important;
  }
  .reveal { opacity: 1 !important; transform: none !important; filter: none !important; }
  .clip-reveal { clip-path: none !important; }
}

@media (hover: none), (pointer: coarse) {
  .cursor { display: none !important; }
}
